{
  "version": 1,
  "routes": "bridge.json",
  "host": {
    "domain_id": 41,
    "setup": [
      "/opt/ros/humble/setup.bash",
      "../../../../chimaera_ros_ws/install/local_setup.bash"
    ],
    "processes": []
  },
  "guest": {
    "domain_id": 42,
    "setup": [
      "/opt/ros/humble/setup.bash",
      "/opt/chimaera/wall_follow/app/local_setup.bash"
    ],
    "processes": [
      {
        "name": "guest_application",
        "command": [
          "ros2",
          "launch",
          "wall_follow_robot",
          "robot.launch.py",
          "parameters_file:=/tmp/chimaera-controller.yaml",
          "command_topic:=/robot/cmd_vel"
        ]
      }
    ]
  },
  "bridge": {
    "interval_us": 50000,
    "poll_us": 10000,
    "steps": 0,
    "max_serialized_bytes": 131072,
    "max_pending_messages": 128,
    "timing_backend": "gazebo",
    "gazebo_world": "wall_arena",
    "physics_step_ns": 1000000,
    "timing_file": "",
    "m5ops": "instruction",
    "wait_for_application": true,
    "startup_timeout_s": 300,
    "status_bar": true,
    "report_seconds": 1.0
  },
  "builds": [
    {
      "sources": [
        "../../../../chimaera_ros_ws/src",
        "../.."
      ],
      "output": "../../../../chimaera_ros_ws",
      "setup": [
        "/opt/ros/humble/setup.bash"
      ],
      "colcon_args": [
        "--cmake-args",
        "-DBUILD_TESTING=ON",
        "-DBUILD_GAZEBO_BRIDGE=ON",
        "-DCMAKE_BUILD_TYPE=Release"
      ]
    }
  ],
  "deploy": {
    "guest_root": "/opt/chimaera/wall_follow",
    "install_trees": [
      {
        "source": "../../../../chimaera_ros_ws/install",
        "destination": "app"
      }
    ]
  }
}
