<?xml version="1.0"?>
<package format="3">
  <name>wall_follow_robot</name><version>0.1.0</version>
  <description>Deployable wall-following robot workload, independent of benchmark infrastructure</description>
  <maintainer email="maintainer@example.com">Chimaera</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclcpp</depend><depend>rcl_interfaces</depend>
  <depend>geometry_msgs</depend><depend>sensor_msgs</depend>
