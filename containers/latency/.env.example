CHIMAERA_SDK_IMAGE=chimaera:jammy-humble-fortress
CHIMAERA_DISK=/absolute/path/to/guest.img
CHIMAERA_KERNEL=/absolute/path/to/kernel
CHIMAERA_DATA=/absolute/path/to/Chimaera/.chimaera-latency/docker
CHIMAERA_BIND=192.168.1.2
CHIMAERA_PORT=8787
CHIMAERA_UID=1000
CHIMAERA_GID=1000
# Set this to: stat -c %g /dev/kvm
CHIMAERA_KVM_GID=108
