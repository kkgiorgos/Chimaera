  </participant>
  <data_writer profile_name="udp_loopback_writer" is_default_profile="true">
    <qos><data_sharing><kind>OFF</kind></data_sharing></qos>
  </data_writer>
  <data_reader profile_name="udp_loopback_reader" is_default_profile="true">
