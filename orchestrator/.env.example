CHIMAERA_SSH_DIR=/absolute/path/to/dedicated/ssh-directory
CHIMAERA_BIND=127.0.0.1
CHIMAERA_PORT=3000
DISCORD_WEBHOOK_URL=

# For workers reached over Tailscale, uncomment both settings. Find your suffix
# with: tailscale status --json (MagicDNSSuffix).
# COMPOSE_FILE=compose.yaml:compose.tailscale.yaml
